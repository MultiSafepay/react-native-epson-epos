{
  "name": "react-native-epson-epos-example",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:local:release:android": "eas build --platform android --profile production --local",
    "build:local:debug:android": "eas build --platform android --profile development --local",
    "build:local:debug:ios": "eas build --platform ios --profile development --local"
  },
  "dependencies": {
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.0.4",
    "expo": "^54.0.23",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.17",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.14",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.12",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "babel-plugin-module-resolver": "^5.0.2",
    "@types/react": "~19.1.0",
    "@types/uuid": "^11.0.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.1.0"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": ".."
    }
  }
}
